# Golden files are byte-compared across platforms (DET-001). A checkout that
# converted them to CRLF would fail the determinism job for a reason that has
# nothing to do with the emitter.
*.xml text eol=lf
*.rs text eol=lf
*.lua text eol=lf
*.sil text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
# The corpus is checked against sha256 sums in its manifest (P1.2), and
# the frontend's files are read by tests too.
*.usfm text eol=lf
*.sfm text eol=lf
*.ts text eol=lf
*.svelte text eol=lf
*.css text eol=lf
*.json text eol=lf
*.mjs text eol=lf

*.pdf binary
*.png binary
*.jpg binary
*.ttf binary
*.docx binary
