\booktitle{புலம்பல்கள்}
\chapternumber{1}

\s1{எருசலேமின் துன்பம்}

\q1{\v{1}ஐயோ, மக்கள் மிகுந்த நகரம்\fn{1:1 எருசலேம்} தனிமையாக உட்கார்ந்திருக்கிறாளே!}
\q1{விதவைக்கு ஒப்பானாளே! தேசங்களில் பெரியவளும்,}
\q1{அந்த தேசங்களில் இளவரசியுமாயிருந்தவள் வரிகட்டுகிறவளானாளே!}

\q1{\v{2}இரவுநேரத்திலே அழுதுகொண்டிருக்கிறாள்;}
\q1{அவளுடைய கண்ணீர் அவள் கன்னங்களில் வடிகிறது;}
\q1{அவளுக்குப் பிரியமானவர்களில் அவளைத் தேற்றுபவர்கள் ஒருவரும் இல்லை;}
\q1{அவளுடைய நண்பர்கள் அனைவரும் அவளுக்குத் துரோகிகளும் விரோதிகளுமானார்கள்.}

\q1{\v{3}யூதா மக்கள் உபத்திரவப்படவும், கொடுமையான அடிமை வேலைசெய்யவும்}
\q1{சிறைப்பட்டுப்போனார்கள். அவள் அந்நிய மக்களுக்குள்ளே தங்குகிறாள்,}
\q1{இளைப்பாறுதல் அடையமாட்டாள்;}
\q1{அவளைத் துன்பப்படுத்துகிற அனைவரும்}
\q1{அவளை அவளுடைய இக்கட்டான நேரங்களிலே தொடர்ந்துபிடித்தார்கள்.}

\q1{\v{4}பண்டிகைக்கு வருபவர்கள் இல்லாததினால்,}
\q1{சீயோனுக்குப் போகிற வழிகள் புலம்புகிறது;}
\q1{அவளுடைய வாசல்கள் எல்லாம் பயனற்றுக்கிடக்கிறது;}
\q1{அவளுடைய ஆசாரியர்கள் தவிக்கிறார்கள்;}
\q1{அவளுடைய இளம்பெண்கள் சஞ்சலப்படுகிறார்கள்;}
