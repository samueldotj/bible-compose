{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BibleCompose",
  "version": "0.1.0",
  "identifier": "bible.compose.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BibleCompose",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 560,
        "label": "main",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
