{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BibleCompose",
  "version": "0.1.1",
  "identifier": "bible.compose.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BibleCompose",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 560,
        "label": "main",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "BibleCompose",
    "category": "Productivity",
    "shortDescription": "Typeset Scripture from USFM",
    "longDescription": "BibleCompose composes a folder of USFM into a printable PDF. It carries its own typesetter, needs no internet connection, and never writes to the Scripture it is given.",
    "copyright": "Copyright the BibleCompose contributors",
    "licenseFile": "../../LICENSE",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
